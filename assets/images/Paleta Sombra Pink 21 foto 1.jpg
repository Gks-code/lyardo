    <script type="text/javascript" charset="utf-8">
      $(document).ready(function(){

  var tam = $(window).width();
  
  if (tam >= 768 ){

//Barra inicial
  $('#rodape .links-rodape-paginas > ul').clone().addClass('span6 paginas-topo').prependTo('.barra-inicial > .conteiner > .row-fluid');
  if ( $('.paginas-topo li').length > 2 ) {
      $('.paginas-topo').prepend('<div class="mais-paginas"> <a href="#">Mais <i class="fa-angle-down"></i></a> <ul></ul> </div>');
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(3)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(4)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(5)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(6)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(7)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(8)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(9)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(10)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(11)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(12)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(13)'));
      $('.mais-paginas>ul').append($('.paginas-topo li:nth-child(14)'));
  }


  $('.listagem-item').each(function(){
    var bandeira = $(this).find('.bandeira-promocao');
    var precoPromocional = $(this).find('.preco-promocional');
    precoPromocional.after(bandeira);
})

if( $('.listagem-linha .listagem-item .bandeira-promocao').length ){
  $('.listagem-linha .listagem-item .bandeira-promocao').each(function () {
      var $this = $(this).text();
      var $result = $(this).text().replace("% Desconto", "");
      $(this).text($result);
  });
}

const imgBannerOne = 'https://cdn.awsli.com.br/2630/2630420/arquivos/banner-menu.png';
const categoryIdOne = 20389973;
const linkBannerOne = "https://demo-melhoria-unique.lojaintegrada.com.br/ofertas";


$('.menu.superior > .nivel-um > .categoria-id-'+categoryIdOne+' .nivel-dois').append('<div id="bannerMenu"><a href="'+ linkBannerOne +'"><img src="' + imgBannerOne + '" alt="Texto alternativo para a imagem" > </a></div>')

  }
});
